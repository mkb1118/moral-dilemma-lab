[
  {
    "id": 201,
    "trait": "开放性",
    "sub": "冒险精神",
    "text": "我喜欢尝试有风险的活动，比如极限运动或独自去陌生的地方旅行。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 202,
    "trait": "开放性",
    "sub": "冒险精神",
    "text": "面对不确定性时，我感到兴奋而非恐惧——未知意味着可能性。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 203,
    "trait": "开放性",
    "sub": "冒险精神",
    "text": "我宁愿选择安全熟悉的路线，也不愿意冒险尝试新的可能性。",
    "key": "O",
    "reverse": true
  },
  {
    "id": 204,
    "trait": "开放性",
    "sub": "非传统性",
    "text": "我认为社会规范和传统中有很多值得反思和挑战的地方。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 205,
    "trait": "开放性",
    "sub": "非传统性",
    "text": "我喜欢用非主流的方式生活和工作，不太在意别人觉得「应该」怎么做。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 206,
    "trait": "开放性",
    "sub": "非传统性",
    "text": "我相信传统价值观是社会的基石，不应轻易挑战。",
    "key": "O",
    "reverse": true
  },
  {
    "id": 207,
    "trait": "尽责性",
    "sub": "成就导向",
    "text": "我有清晰的人生目标，每天都在为之努力，不满足于平庸。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 208,
    "trait": "尽责性",
    "sub": "成就导向",
    "text": "即使已经做得很好了，我仍然觉得还可以再提升一步。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 209,
    "trait": "尽责性",
    "sub": "成就导向",
    "text": "我对自己目前的成就已经感到满意，不需要追求更高的目标。",
    "key": "C",
    "reverse": true
  },
  {
    "id": 210,
    "trait": "尽责性",
    "sub": "自律",
    "text": "即使没有外部监督和截止日期，我也能保持高效率的工作节奏。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 211,
    "trait": "尽责性",
    "sub": "自律",
    "text": "当我想专心做事时，我能轻易抵抗手机、社交媒体和其他干扰。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 212,
    "trait": "尽责性",
    "sub": "自律",
    "text": "我经常被眼前的小快乐诱惑，从而推迟了重要的长期目标。",
    "key": "C",
    "reverse": true
  },
  {
    "id": 213,
    "trait": "外向性",
    "sub": "活力水平",
    "text": "我的一天通常安排得很满，喜欢保持忙碌和活跃的状态。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 214,
    "trait": "外向性",
    "sub": "活力水平",
    "text": "即使没有特别的事情，我也总想做点什么，不太喜欢长时间闲着。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 215,
    "trait": "外向性",
    "sub": "活力水平",
    "text": "比起快节奏的生活，我更享受悠闲、缓慢的步调。",
    "key": "E",
    "reverse": true
  },
  {
    "id": 216,
    "trait": "外向性",
    "sub": "寻求刺激",
    "text": "我喜欢刺激和强烈的感官体验——比如坐过山车、看恐怖片或去热闹的音乐节。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 217,
    "trait": "外向性",
    "sub": "寻求刺激",
    "text": "热闹的派对、拥挤的场馆和大型活动让我感到兴奋和快乐。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 218,
    "trait": "外向性",
    "sub": "寻求刺激",
    "text": "我更喜欢安静平和的环境，喧闹和过度的刺激让我感到烦躁。",
    "key": "E",
    "reverse": true
  },
  {
    "id": 219,
    "trait": "宜人性",
    "sub": "谦逊",
    "text": "我不太喜欢谈论自己的成就，觉得那样会显得在炫耀。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 220,
    "trait": "宜人性",
    "sub": "谦逊",
    "text": "我认为每个人都有值得我学习的地方，不论他们的地位或背景如何。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 221,
    "trait": "宜人性",
    "sub": "谦逊",
    "text": "我觉得自己比大多数人更优秀，值得更好的待遇。",
    "key": "A",
    "reverse": true
  },
  {
    "id": 222,
    "trait": "宜人性",
    "sub": "直率",
    "text": "我是一个坦率直接的人，即使说出真相会让别人不舒服，我也会坦诚相告。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 223,
    "trait": "宜人性",
    "sub": "直率",
    "text": "我宁愿说出善意的谎言，也不愿意让朋友面对残酷的真相。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 224,
    "trait": "宜人性",
    "sub": "直率",
    "text": "我欣赏那些有话直说、不拐弯抹角的人，即使有时候不那么中听。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 225,
    "trait": "情绪稳定性",
    "sub": "自我意识",
    "text": "在社交场合中，我经常担心自己会说错话或做错事，被人评判。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 226,
    "trait": "情绪稳定性",
    "sub": "自我意识",
    "text": "我很容易感到尴尬和难为情，尤其是当别人关注我的时候。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 227,
    "trait": "情绪稳定性",
    "sub": "自我意识",
    "text": "我不太在意别人怎么看我，很少因为外界的评价感到不自在。",
    "key": "N",
    "reverse": false
  },
  {
    "id": 228,
    "trait": "情绪稳定性",
    "sub": "愤怒倾向",
    "text": "我有的时候会突然感到很恼火，自己都说不清为什么。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 229,
    "trait": "情绪稳定性",
    "sub": "愤怒倾向",
    "text": "即使面对不公平的对待，我也很少表现出愤怒，能冷静处理。",
    "key": "N",
    "reverse": false
  },
  {
    "id": 230,
    "trait": "情绪稳定性",
    "sub": "愤怒倾向",
    "text": "当事情不如预期时，我容易变得烦躁和不耐烦。",
    "key": "N",
    "reverse": true
  }
]