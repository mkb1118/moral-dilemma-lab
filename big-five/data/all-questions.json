[
  {
    "id": 1,
    "trait": "开放性",
    "sub": "创意想象",
    "text": "我的脑海中经常涌现出新的想法和可能性，喜欢天马行空的想象。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 2,
    "trait": "开放性",
    "sub": "创意想象",
    "text": "我对新鲜和未知的事物充满好奇，喜欢尝试没做过的事。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 3,
    "trait": "开放性",
    "sub": "创意想象",
    "text": "我喜欢用不同的角度看待熟悉的问题，寻找新的解决方式。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 4,
    "trait": "开放性",
    "sub": "审美敏感",
    "text": "我对艺术、音乐和文学有强烈的感受力，容易被美好的事物打动。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 5,
    "trait": "开放性",
    "sub": "审美敏感",
    "text": "大自然和艺术品常常让我感到敬畏和心潮澎湃。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 6,
    "trait": "开放性",
    "sub": "思辨深度",
    "text": "我喜欢思考抽象和复杂的问题，享受智力上的挑战。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 7,
    "trait": "开放性",
    "sub": "思辨深度",
    "text": "我对哲学、科学或社会议题有持续的探索兴趣。",
    "key": "O",
    "reverse": false
  },
  {
    "id": 8,
    "trait": "开放性",
    "sub": "创意想象",
    "text": "相比冒险和变化，我更喜欢熟悉和可预测的生活方式。",
    "key": "O",
    "reverse": true
  },
  {
    "id": 9,
    "trait": "尽责性",
    "sub": "条理规划",
    "text": "我做事有计划有条理，会提前安排好时间和优先级。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 10,
    "trait": "尽责性",
    "sub": "条理规划",
    "text": "我的房间和工作桌面通常保持整洁有序，我知道每样东西在哪。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 11,
    "trait": "尽责性",
    "sub": "坚持完成",
    "text": "我对自己承诺的事情会坚持到底，很少半途而废。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 12,
    "trait": "尽责性",
    "sub": "坚持完成",
    "text": "即使任务变得困难或枯燥，我也能逼自己继续前进。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 13,
    "trait": "尽责性",
    "sub": "细节完美",
    "text": "我注重细节，追求把每件事做到最好而不仅仅是「完成」。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 14,
    "trait": "尽责性",
    "sub": "细节完美",
    "text": "在提交工作之前，我会反复检查，确保没有错误。",
    "key": "C",
    "reverse": false
  },
  {
    "id": 15,
    "trait": "尽责性",
    "sub": "条理规划",
    "text": "我喜欢随心所欲地做事，不太喜欢被计划和日程约束。",
    "key": "C",
    "reverse": true
  },
  {
    "id": 16,
    "trait": "尽责性",
    "sub": "坚持完成",
    "text": "有时我觉得自己缺乏自律，会拖延那些需要长期坚持的事情。",
    "key": "C",
    "reverse": true
  },
  {
    "id": 17,
    "trait": "外向性",
    "sub": "社交能量",
    "text": "在聚会或社交场合中，我充满活力，主动与人交谈。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 18,
    "trait": "外向性",
    "sub": "社交能量",
    "text": "和很多人待在一起让我感到充电和兴奋，而不是消耗。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 19,
    "trait": "外向性",
    "sub": "主导表达",
    "text": "在群体讨论中，我经常是那个首先发言或主导话题的人。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 20,
    "trait": "外向性",
    "sub": "主导表达",
    "text": "我喜欢成为人们关注的焦点，不介意在众人面前表现自己。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 21,
    "trait": "外向性",
    "sub": "积极情绪",
    "text": "我总体上是一个乐观开朗的人，经常感到快乐和满足。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 22,
    "trait": "外向性",
    "sub": "积极情绪",
    "text": "我容易对生活充满热情，常常感染身边的人。",
    "key": "E",
    "reverse": false
  },
  {
    "id": 23,
    "trait": "外向性",
    "sub": "社交能量",
    "text": "我更享受独处或小范围的深度交流，嘈杂的社交让我感到疲惫。",
    "key": "E",
    "reverse": true
  },
  {
    "id": 24,
    "trait": "外向性",
    "sub": "主导表达",
    "text": "在社交场合我通常比较安静，不太主动发起话题。",
    "key": "E",
    "reverse": true
  },
  {
    "id": 25,
    "trait": "宜人性",
    "sub": "共情关怀",
    "text": "看到别人遇到困难或伤心，我会本能地想要帮忙和安慰。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 26,
    "trait": "宜人性",
    "sub": "共情关怀",
    "text": "我很容易感受到他人的情绪状态，好像那是我自己的一样。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 27,
    "trait": "宜人性",
    "sub": "合作妥协",
    "text": "我尽量避免与人发生冲突，即使需要牺牲一些自己的利益也会选择妥协。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 28,
    "trait": "宜人性",
    "sub": "合作妥协",
    "text": "在团队合作中，我乐于配合他人，不太计较个人得失。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 29,
    "trait": "宜人性",
    "sub": "信任善意",
    "text": "我相信大多数人本质上是善良的，我愿意给别人第二次机会。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 30,
    "trait": "宜人性",
    "sub": "信任善意",
    "text": "即使陌生人向我求助，我也倾向于相信对方。",
    "key": "A",
    "reverse": false
  },
  {
    "id": 31,
    "trait": "宜人性",
    "sub": "共情关怀",
    "text": "有时候我会把自己的需求放在第一位，即使这会影响到别人的利益。",
    "key": "A",
    "reverse": true
  },
  {
    "id": 32,
    "trait": "宜人性",
    "sub": "合作妥协",
    "text": "当别人做错事时，我不会轻易原谅，而是会让他们承担后果。",
    "key": "A",
    "reverse": true
  },
  {
    "id": 33,
    "trait": "情绪稳定性",
    "sub": "焦虑倾向",
    "text": "我经常感到焦虑和紧张，即使事情本身并不严重。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 34,
    "trait": "情绪稳定性",
    "sub": "焦虑倾向",
    "text": "我容易反复担忧未来，脑子里很难真正放松下来。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 35,
    "trait": "情绪稳定性",
    "sub": "情绪波动",
    "text": "我的情绪起伏比较大，容易被小事影响一整天的心情。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 36,
    "trait": "情绪稳定性",
    "sub": "情绪波动",
    "text": "我会因为别人的一句话或一个表情而反复琢磨很久。",
    "key": "N",
    "reverse": true
  },
  {
    "id": 37,
    "trait": "情绪稳定性",
    "sub": "自信抗压",
    "text": "即使面对很大的压力，我也能保持冷静和清晰的思考。",
    "key": "N",
    "reverse": false
  },
  {
    "id": 38,
    "trait": "情绪稳定性",
    "sub": "自信抗压",
    "text": "我对自己的能力和生活总体上感到满意和自信。",
    "key": "N",
    "reverse": false
  },
  {
    "id": 39,
    "trait": "情绪稳定性",
    "sub": "焦虑倾向",
    "text": "我是一个心态平和的人，不太容易为小事感到紧张。",
    "key": "N",
    "reverse": false
  },
  {
    "id": 40,
    "trait": "情绪稳定性",
    "sub": "自信抗压",
    "text": "挫折和失败不会轻易打倒我，我能较快地从打击中恢复。",
    "key": "N",
    "reverse": false
  }
]