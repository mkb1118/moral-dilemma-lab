# 复制本文件为 .env 并填入真实值
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/psychlab"

# 用 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" 生成
JWT_SECRET="replace-with-a-long-random-string"

PORT=3000

# 可选：CORS 白名单（逗号分隔），默认仅本地
# CORS_ORIGIN="http://127.0.0.1:3000,http://localhost:3000"

# 可选：题目数据目录（默认项目根下的 测试广场/，即各测试目录的 data/）
# DATA_DIR="E:/my project/测试广场"
